# Text generation provider: Gemini; embeddings: Cloudflare BGE-M3.
TEXT_GENERATION_PROVIDER=gemini
TEXT_REVIEW_REASONING_EFFORT=medium
TEXT_ANSWER_REASONING_EFFORT=medium
# Canonical source character budget; reduce for models with smaller contexts.
RAG_SOURCE_MAX_CHARS=60000
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_REVIEW_MODEL=gemini-3.8-flash
GEMINI_REVIEW_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_MAX_TOKENS=2000
GEMINI_TIMEOUT_SECONDS=90
# Optional Qdrant server; blank uses data/qdrant locally.
QDRANT_URL=
QDRANT_API_KEY=
CLOUDFLARE_API_TOKEN=replace_with_your_token
CLOUDFLARE_ACCOUNT_ID=replace_with_your_account_id
EMBEDDING_MODEL=@cf/baai/bge-m3
